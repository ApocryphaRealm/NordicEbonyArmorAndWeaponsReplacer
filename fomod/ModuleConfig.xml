<?xml version="1.0" encoding="UTF-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
	<moduleName>Nordic Ebony Armor and Weapons Replacer</moduleName>
	<moduleImage path="fomod\images\header.png" showImage="true" showFade="true" height="-1" />

	<!-- Meshes, the light plugin and the TruePBR textures (our black recolour of NordwarUA's own maps, 2K): the same whatever you pick below.
	     The ebony mace, warhammer, bow, arrows and quiver are built from the Wolf weapons' own pieces. -->
	<requiredInstallFiles>
		<folder source="00 Core" destination="" priority="0" />
	</requiredInstallFiles>

	<installSteps order="Explicit">
		<installStep name="The cuirass">
			<optionalFileGroups order="Explicit">
				<group name="Fur collar" type="SelectExactlyOne">
					<plugins order="Explicit">
						<plugin name="With the fur collar">
							<description>The cuirass as NordwarUA built it, with the fur mantle across the shoulders - in black, recoloured from his own fur.</description>
							<image path="fomod\images\fur.png" />
							<files />
							<typeDescriptor><type name="Recommended" /></typeDescriptor>
						</plugin>
						<plugin name="Without the fur collar">
							<description>NordwarUA's collarless version of the same cuirass. Nothing else changes.</description>
							<image path="fomod\images\nofur.png" />
							<files><folder source="10 Cuirass - No fur collar" destination="" priority="2" /></files>
							<typeDescriptor><type name="Optional" /></typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>

		<installStep name="Body">
			<optionalFileGroups order="Explicit">
				<group name="Body support" type="SelectAny">
					<plugins order="Explicit">
						<plugin name="CBBE 3BA - BodySlide files">
							<description>Slider sets and shape data to build the female set to your CBBE 3BA preset in BodySlide (no physics), from Xonek's Legacy of Ysgramor - 3BA Bodyslide (permissions as Legacy of Ysgramor's), under the group "Nordic Ebony - CBBE 3BA". Nothing is prebuilt: build them once in BodySlide.</description>
							<image path="fomod\images\cbbe3ba.png" />
							<files><folder source="30 BodySlide - CBBE 3BA" destination="" priority="4" /></files>
							<typeDescriptor><type name="Optional" /></typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
	</installSteps>
</config>
